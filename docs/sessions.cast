{"version": 2, "width": 130, "height": 30, "timestamp": 1755697200, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.0, "o", "\u001b[36;1m# adhammer 1.3.9 — session hunting three ways\u001b[0m\r\n\r\n"]
[1.0, "o", "\u001b[35m$\u001b[0m adhammer enum sessions --host <dc-ip> --user administrator --password \u001b[90m********\u001b[0m\r\n"]
[3.0, "o", "\u001b[32;1m[+]\u001b[0m 1 session(s) on <dc-ip>:\r\n    administrator            from \\\\192.168.91.254\r\n\r\n"]
[4.2, "o", "\u001b[35m$\u001b[0m adhammer enum wkssvc --host <dc-ip> --user administrator --password \u001b[90m********\u001b[0m\r\n"]
[6.5, "o", "\u001b[33m[-]\u001b[0m no logged-on users on <dc-ip> (raw=7, machine-hidden=7)\r\n    pass \u001b[36m--include-machine\u001b[0m to show machine-account sessions\r\n\r\n"]
[8.0, "o", "\u001b[35m$\u001b[0m adhammer enum wkssvc --host <dc-ip> --user administrator --password \u001b[90m********\u001b[0m --include-machine\r\n"]
[10.3, "o", "\u001b[32;1m[+]\u001b[0m 1 unique principal(s) on <dc-ip> (raw=7, machine-hidden=0):\r\n    TESTLAB\\DC01$                    server=(none) \u001b[33;1m×7\u001b[0m\r\n\r\n"]
[11.8, "o", "\u001b[35m$\u001b[0m adhammer enum hku --host <dc-ip> --user administrator --password \u001b[90m********\u001b[0m\r\n"]
[13.9, "o", "\u001b[32;1m[+]\u001b[0m 1 logged-on SID(s) via HKU on <dc-ip>:\r\n    S-1-5-21-XXXX-YYYY-ZZZZ-500\r\n\r\n"]
[15.2, "o", "\u001b[35m$\u001b[0m adhammer --json enum wkssvc --host <dc-ip> --user administrator --password \u001b[90m********\u001b[0m | jq\r\n"]
[17.3, "o", "\u001b[33m[-]\u001b[0m no logged-on users on <dc-ip> (raw=7, machine-hidden=7)\r\n    pass --include-machine to show machine-account sessions\r\n"]
[17.5, "o", "\u001b[38;5;145m{\u001b[0m\r\n  \u001b[33m\"command\"\u001b[0m: \u001b[32m\"adhammer enum wkssvc\"\u001b[0m,\r\n  \u001b[33m\"success\"\u001b[0m: \u001b[35mtrue\u001b[0m,\r\n  \u001b[33m\"evidence\"\u001b[0m: \u001b[32m\"\"\u001b[0m\r\n\u001b[38;5;145m}\u001b[0m\r\n\r\n"]
[19.0, "o", "\u001b[36;1m# srvsvc + wkssvc + rrp/hku — full session-hunt coverage.\u001b[0m\r\n"]
[21.0, "o", ""]
