[0.0, "o", "\u001b[36;1m# adhammer — one static binary. Kali or Windows. AD kill chain in 40s.\u001b[0m\r\n\r\n"]
[1.5, "o", "\u001b[35m$\u001b[0m adhammer scan --url ldaps://<dc-ip>:636 --insecure --user administrator@testlab.local --password \u001b[90m********\u001b[0m --format html --bloodhound bh.zip\r\n"]
[3.5, "o", "\u001b[36m[*]\u001b[0m Collecting via LDAPS: 512 users, 218 computers, 42 groups (SD_FLAGS)\r\n"]
[4.5, "o", "\u001b[36m[*]\u001b[0m Building control-path graph: 774 nodes, 3421 edges\r\n"]
[5.4, "o", "\u001b[36m[*]\u001b[0m Running 41 hygiene checks + ESC1-15 ADCS rule pack\r\n"]
[6.6, "o", "\u001b[32;1m[+]\u001b[0m 18 findings — 5 HIGH, 8 MEDIUM, 5 LOW\r\n"]
[7.4, "o", "\u001b[32;1m[+]\u001b[0m Cheapest chain to Tier-0 (3 hops):\r\n"]
[7.9, "o", "    labuser  \u001b[33m→\u001b[0m  Server Operators  \u001b[33m→\u001b[0m  DC01$  \u001b[31;1m⇒ Domain Admins\u001b[0m\r\n"]
[8.6, "o", "\u001b[32;1m[+]\u001b[0m Report:     report.html  (18 findings + attack chains + ATT&CK map)\r\n"]
