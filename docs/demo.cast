[19.4, "o", "\u001b[32;1m[+]\u001b[0m krbtgt KVNO=2\r\n"]
[19.7, "o", "krbtgt:aad3b435b51404eeaad3b435b51404ee:\u001b[33m1b7d3c…decrypted…\u001b[0m:::\r\n"]
