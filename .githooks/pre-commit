#!/usr/bin/env bash
# WS-LEAK-HOOK — block staged diffs that carry known lab identifiers.
# Extend LEAK_TERMS below when a new lab (DC / SID / account) enters the
# session. Bypass only with --no-verify AND a note in the commit body
# saying why the leak is intentional (a synthetic KAT constant, etc).
set -e

ROOT=$(git rev-parse --show-toplevel)
LEAK_TERMS_FILE="$ROOT/.githooks/leak-terms.txt"
if [ ! -s "$LEAK_TERMS_FILE" ]; then
    echo "pre-commit BLOCKED: $LEAK_TERMS_FILE is missing or empty." >&2
    exit 1
fi

# Files that legitimately reference the leak strings (the hook itself as a
# regex; the canonical regex list; docs describing the leak in prose; and the
# security memory note). The receipt scrubber loads the same canonical list,
# so its source no longer needs a blanket exclusion.
# Extend when a new legit reference lands in-tree.
SKIP_PATHS=':(exclude).githooks/pre-commit :(exclude).githooks/leak-terms.txt :(exclude)docs/AUDIT_*.md :(exclude)SECURITY.md :(exclude)docs/adr/*.md'

CHECK_OUTPUT=$(mktemp)
ADDED_LINES=$(mktemp)
trap 'rm -f "$CHECK_OUTPUT" "$ADDED_LINES"' EXIT

# Scan only added content. Removing a historical secret must not make the
# cleanup commit impossible, and diff metadata (`+++ b/path`) is not content.
git diff --cached --unified=0 -- . $SKIP_PATHS |
    awk '/^\+\+\+ / { next } /^\+/ { print substr($0, 2) }' > "$ADDED_LINES"

if grep -inE -f "$LEAK_TERMS_FILE" "$ADDED_LINES" > "$CHECK_OUTPUT" 2>&1; then
    echo "======================================================================"
    echo " pre-commit BLOCKED: staged diff contains known lab identifier."
    echo "======================================================================"
    head -20 "$CHECK_OUTPUT"
    echo "----------------------------------------------------------------------"
    echo " Redact BEFORE staging. Rule: docs/PLAN_1.4.9.md § WS-LEAK-HOOK."
    echo " Placeholder examples:"
    echo "   password  ->  <lab-password>"
    echo "   SID       ->  S-1-5-21-XXXX-YYYY-ZZZZ-500"
    echo "   IP        ->  <dc-ip> / 10.X.X.X"
    echo " To bypass (only for synthetic fixtures generated by docs/synthetic_kat.py):"
    echo "   git commit --no-verify -m ..."
    echo "======================================================================"
    exit 1
else
    grep_status=$?
    if [ "$grep_status" -ne 1 ]; then
        echo "======================================================================" >&2
        echo " pre-commit BLOCKED: canonical leak patterns could not be evaluated." >&2
        echo "======================================================================" >&2
        head -20 "$CHECK_OUTPUT" >&2
        exit 2
    fi
fi
exit 0
